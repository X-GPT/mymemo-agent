# The trusted In-VM server (spec #654, ticket #662). One process serves one
# Conversation. Copy to .env for a local run against the Compose postgres +
# redis (docker compose up -d postgres redis, then apply migrations with
# `bun run db:migrate` from apps/chat-api).

# Writable mymemo_agent database — the work bus. Never the generic
# DATABASE_URL, which names the read-only KB elsewhere in the repo.
# AGENT_DATABASE_URL=postgresql://mymemo:mymemo@localhost:5432/mymemo_agent
# DB_SSL=disable

# v2 Turn Live Stream lane. Production requires authenticated rediss://; the
# escape hatch below allows plaintext loopback for local runs only.
# REDIS_URL=redis://127.0.0.1:6379
# LIVE_STREAM_ALLOW_INSECURE_LOCAL_REDIS=true

# The Conversation this VM serves (delivered via runHookPayload in production).
# MYMEMO_USER_ID=local-user
# MYMEMO_CONVERSATION_ID=local-conversation

# The Workspace — cwd for the confined file tools.
# WORKSPACE_DIR=/tmp/mymemo-workspace

# Model access for the trusted process: locally direct (e.g. OpenRouter); in
# production the chat-api /v2/gateway URL and the per-Conversation token.
# MODEL_BASE_URL=https://openrouter.ai/api
# MODEL_API_KEY=sk-or-...
# MODEL=anthropic/claude-sonnet-5

# Production only (delivered via runHookPayload): chat-api's Checkpoint door.
# The lifecycle hooks that use it never fire locally.
# CHECKPOINT_URL=http://<internal-alb>/v2/checkpoint/<conversation>

# PORT=8080
# LOG_LEVEL=info
