# chat-api environment template — copy to apps/chat-api/.env and fill in.
#
# This lists EVERY variable chat-api reads (src/config/env.ts and, for the
# local-only Harness chat path, src/config/harness-env.ts), so it doubles as
# deployment documentation. Legend: [required] must be set (prod); [secret] must
# come from a secret store, never source control; [optional] has a default.
#
# Local docker-compose harness: compose.yaml sets the non-secret wiring inline
# under `environment:`, and inline values OVERRIDE this file — so `docker compose
# up` needs nothing here. The vars below are shown (commented) for documentation
# and for running chat-api directly (`bun run dev`) outside compose. In
# production, supply every [required] var via your platform / Secrets Manager.

# ── Required ──────────────────────────────────────────────────────────────────

# [required] Writable mymemo_agent Postgres: conversation registry (frozen
# scope), run queue, run event log. A DIFFERENT database/credential from the
# worker's read-only KB — never the KB URL. Local harness: set inline in
# compose.yaml. Prod: from Secrets Manager.
# AGENT_DATABASE_URL=postgresql://user:password@host:5432/mymemo_agent

# [required] Private S3 bucket containing durable Downloadable artifact
# objects. Use task-role credentials; do not configure AWS access keys here.
# ARTIFACT_BUCKET=mymemo-agent-dev-artifacts

# [required] AWS region containing ARTIFACT_BUCKET.
# AWS_REGION=us-west-2

# [required][secret] Authenticated TLS URL for the per-Run AG-UI Live Stream
# relay. Inject from a secret store; never log it.
# REDIS_URL=rediss://default:password@redis.internal:6379

# [required unless break-glass][secret] Statsig server secret backing the agent
# exposure gate (mymemo_agent_split_runtime_enabled). NOT needed locally: the
# harness sets AGENT_EXPOSURE_BREAK_GLASS=true, which opens the gate without
# Statsig. Required in production, where break-glass is off and the gate fails
# closed. Never sent to the sandbox or logged.
# STATSIG_SERVER_SECRET=secret-...

# ── Optional (defaults shown) ───────────────────────────────────────────────────

# Operator break-glass for the exposure gate: when "true", new agent work is
# allowed without Statsig (local dev, or a Statsig outage). Default off — the
# gate fails closed. The local harness sets this true inline in compose.yaml.
# AGENT_EXPOSURE_BREAK_GLASS=false

# Spliced into AGENT_DATABASE_URL when it is passwordless (the platform-injected
# form). Leave unset when AGENT_DATABASE_URL already carries its password.
# DB_PASSWORD=

# Postgres TLS. On by default (appends sslmode=require); set "disable" for a
# local non-TLS Postgres.
# DB_SSL=disable

# pino log level.
# LOG_LEVEL=info

# HTTP listen port (Bun server).
# PORT=3000

# ── /v2 model gateway (ADR-0034) ─────────────────────────────────────────────
#
# The gateway route (/v2/gateway/:conversationId/*) is the MicroVM's single
# door to the model provider. Both secrets stay in chat-api env only — never in
# a VM, image, or Checkpoint. While either is unset the route answers 503 and
# everything else serves normally.

# [secret] Real OpenRouter credential injected on gateway-forwarded requests.
# OPENROUTER_API_KEY=sk-or-...

# [secret] HMAC key for per-Conversation gateway tokens (mint + verify are both
# in chat-api).
# GATEWAY_TOKEN_SECRET=

# Upstream base URL the gateway forwards to.
# OPENROUTER_BASE_URL=https://openrouter.ai/api

# ── Harness-hosted AI SDK chat (local only) ──────────────────────────────────
#
# Read only by the local composition (local/index.ts) through
# src/config/harness-env.ts; the production ApiConfig never reads any of these.
# compose.yaml passes the required ones through from your shell and sets
# KB_DATABASE_URL inline.

# [required][secret] Vercel Sandbox credentials, passed explicitly to
# createVercelSandbox (@vercel/sandbox does not read them from the env).
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=team_...
# VERCEL_PROJECT_ID=prj_...

# [required][secret] Model credential for the Claude Code adapter; the sandbox
# only ever sees a brokered placeholder.
# OPENROUTER_API_KEY=sk-or-...

# [required][secret] Read-only mymemo_kb URL the document tools (ListDocuments,
# SearchDocuments, LoadDocuments) query in this process. Never the writable
# AGENT_DATABASE_URL.
# KB_DATABASE_URL=postgresql://user:password@host:5432/mymemo_kb

# Model routing (defaults shown).
# OPENROUTER_BASE_URL=https://openrouter.ai/api
# OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-5

# Maximum wall-clock lifetime of one Harness sandbox session, in milliseconds.
# HARNESS_SANDBOX_TIMEOUT_MS=600000

# Vercel region; snapshots are region-bound.
# HARNESS_SANDBOX_REGION=iad1
