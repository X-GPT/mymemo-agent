{
	"name": "agent-worker",
	"exports": {
		"./claude-code-executable": "./src/sdk/claude-code-executable.ts",
		"./config": "./src/config/env.ts",
		"./logger": "./src/logger.ts",
		"./production-run-resources": "./src/production-run-resources.ts",
		"./run-serving": "./src/run-serving.ts"
	},
	"scripts": {
		"test": "bun test --timeout=30000",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run src/index.ts",
		"start:agentcore-publisher": "bun run src/agentcore-dispatch/main.ts",
		"spike:e2b": "bun run spikes/e2b-semantics/spike.ts",
		"template:build": "bun run e2b-template/build.ts",
		"template:verify": "bun run e2b-template/verify.ts",
		"format": "biome format --write",
		"lint": "biome lint --write",
		"check": "biome check --write"
	},
	"dependencies": {
		"@ag-ui/core": "^0.0.57",
		"@anthropic-ai/claude-agent-sdk": "0.3.233",
		"@anthropic-ai/sdk": "^0.113.0",
		"@aws-sdk/client-s3": "^3.883.0",
		"@aws-sdk/client-sqs": "^3.1110.0",
		"@aws-sdk/client-ssm": "^3.1110.0",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@mymemo/agent-db": "workspace:*",
		"@mymemo/live-text": "workspace:*",
		"agentcore-canary-dispatch": "workspace:*",
		"ajv": "^8.18.0",
		"drizzle-orm": "^0.45.2",
		"e2b": "^2.14.0",
		"pg": "^8.22.0",
		"pino": "^9.14.0",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.11",
		"@electric-sql/pglite": "^0.5.3",
		"@types/bun": "^1.3.11",
		"@types/pg": "^8.20.0"
	}
}
